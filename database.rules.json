{
  "rules": {
    ".read": false,
    ".write": false,
    "products": { ".indexOn": ["category", "published"], "$id": { ".read": "data.child('published').val() === true" } },
    "categories": { ".read": true },
    "designTemplates": { "$id": { ".read": "data.child('published').val() === true" } },
    "publicDesigns": { "$id": { ".read": true } },
    "userDesigns": { "$uid": { ".read": "auth != null && auth.uid === $uid" } },
    "users": { "$uid": { ".read": "auth != null && auth.uid === $uid" } },
    "ordersByUser": { "$uid": { ".read": "auth != null && auth.uid === $uid" } },
    "reviews": { "$id": { ".read": "data.child('published').val() === true" } },
    "settings": { "public": { ".read": true } }
  }
}
