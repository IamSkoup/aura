{
  "name": "aura-wear",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "emulators": "node scripts/start-emulators.mjs",
    "seed": "node --env-file=.env.local --import tsx scripts/seed.ts",
    "seed:catalog": "node --env-file=.env.local --import tsx scripts/seed-catalog.ts",
    "test": "vitest run",
    "grant-admin": "node --env-file=.env.local --import tsx scripts/grant-admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.950.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.2",
    "firebase": "^12.6.0",
    "firebase-admin": "^13.6.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.34.4",
    "three": "^0.180.0",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "@types/three": "^0.180.0",
    "eslint": "^9.38.0",
    "eslint-config-next": "^15.5.6",
    "firebase-tools": "^14.22.0",
    "playwright-core": "^1.64.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
