# Local emulator values. Replace all NEXT_PUBLIC_FIREBASE_* values with your Firebase web app settings in production.
NEXT_PUBLIC_FIREBASE_API_KEY=local-emulator-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=aura-wear-local.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=aura-wear-local
NEXT_PUBLIC_FIREBASE_APP_ID=aura-wear-local-app
NEXT_PUBLIC_FIREBASE_DATABASE_URL=http://127.0.0.1:9000?ns=aura-wear-local-default-rtdb
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
NEXT_PUBLIC_FIREBASE_DATABASE_EMULATOR_HOST=127.0.0.1:9000
FIREBASE_PROJECT_ID=aura-wear-local
FIREBASE_DATABASE_URL=http://127.0.0.1:9000?ns=aura-wear-local-default-rtdb
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_DATABASE_EMULATOR_HOST=127.0.0.1:9000
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
# Production: use workload identity / GOOGLE_APPLICATION_CREDENTIALS. Never commit a service account.
# Alternative for a secure cloud environment: FIREBASE_SERVICE_ACCOUNT_JSON as a secret variable. Never put its value in this file.
# Firebase App Hosting: set STORAGE_PROVIDER=firebase and FIREBASE_STORAGE_BUCKET to your private Firebase Storage bucket.
# STORAGE_PROVIDER=firebase
# FIREBASE_STORAGE_BUCKET=aurawear-4be25.firebasestorage.app
# Object storage required in production for original uploads and production files.
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# PAYMENT_PROVIDER=none
# PAYMENT_WEBHOOK_SECRET=
# For YooKassa after merchant setup:
# PAYMENT_PROVIDER=yookassa
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=
# NEXT_PUBLIC_SITE_URL=https://your-domain.example
