# Firebase Web App — значения из настроек проекта Firebase
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com

# Firebase Admin — используются только сервером
FIREBASE_PROJECT_ID=your-project
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
# На сервере используйте GOOGLE_APPLICATION_CREDENTIALS или идентификацию рабочей нагрузки
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Приватное файловое хранилище (выберите один вариант)
STORAGE_PROVIDER=firebase
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
# Альтернатива — S3:
# STORAGE_PROVIDER=s3
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Оплата. До подключения остаётся none
PAYMENT_PROVIDER=none
# PAYMENT_PROVIDER=yookassa
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=
# YOOKASSA_VAT_CODE=
NEXT_PUBLIC_SITE_URL=https://your-domain.example
